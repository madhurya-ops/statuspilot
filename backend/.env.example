# --- LLM (Groq only) ---
LLM_PRIMARY=groq                  # groq | mock
GROQ_API_KEY=
GROQ_MODEL=                       # current large instruct model ID
GROQ_MODEL_FALLBACK=              # smaller/faster model ID, used on 429 or JSON failure

# --- Judgments (Jev) ---
DECISION_ENGINE=jev               # jev | llm | mock
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_CONCURRENCY=5                 # parallel candidate requests; keep modest
JEV_TIMEOUT_S=20

# --- Routing thresholds (policy lives in code, values here) ---
CONF_AUTO=0.80                    # >= this -> auto-accept
CONF_REVIEW=0.50                  # < this -> must review; between -> "suggested"
NOUL_YES=0.65                     # >= this -> treat as explicitly stated
NOUL_NO=0.35                      # <= this -> treat as not stated; between -> "inferred"

# --- App ---
DEMO_ACCESS_CODE=
ALLOWED_ORIGINS=http://localhost:5173
MAX_INPUT_CHARS=60000
MAX_UPLOAD_BYTES=1000000
MAX_CANDIDATES=40                 # hard cap on Jev fan-out per run
RATE_LIMIT_PER_MIN=10
